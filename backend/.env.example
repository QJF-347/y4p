# Copy to .env and adjust. Never commit real secrets.
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://orange:orange@localhost:5432/orange
LOG_LEVEL=info

JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_ISSUER=orange-pos-api
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
DEVICE_TOKEN_TTL_SEC=15552000

# Daraja sandbox defaults; DARAJA_FAKE=1 skips network calls in dev/tests.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CALLBACK_URL=http://localhost:8080/api/v1/payments/daraja/callback
DARAJA_CALLBACK_SECRET=dev-callback-secret
DARAJA_FAKE=1

STK_TIMEOUT_MINUTES=5
RAW_PAYLOAD_DIR=./var/raw-payloads
